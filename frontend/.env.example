# Public build-time variables only (anything prefixed VITE_ is embedded in the bundle).
# Never put the Crustdata key, model keys or the operator token here.

# Backend API base. Routes are called as <base>/api/... (API_CONTRACT.md v1).
# The backend's default CORS allowlist covers http://localhost:5173 and http://127.0.0.1:5173;
# a frontend served elsewhere needs the backend's CORS_ORIGINS to include its origin.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Frontend development mode: replaces the HTTP client with clearly labeled in-browser
# fixtures so the UI can be exercised without a backend. Leave false for the real backend.
VITE_USE_MOCK_API=false
