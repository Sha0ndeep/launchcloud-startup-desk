  "components": {
    "schemas": {
      "ApplicationInput": {
        "properties": {
          "company_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 2,
            "title": "Company Name"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "applicant_name": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Applicant Name"
          },
          "work_email": {
            "type": "string",
            "maxLength": 254,
            "title": "Work Email"
          },
          "applicant_role": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Applicant Role"
          },
          "product_description": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 10,
            "title": "Product Description"
          },
          "product_kind": {
            "type": "string",
            "enum": [
              "software",
              "other",
              "unknown"
            ],
            "title": "Product Kind",
            "default": "unknown"
          },
          "profile_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profile Url"
          },
          "founding_year": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2100.0,
                "minimum": 1800.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Founding Year"
          },
          "headcount": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Headcount"
          },
          "funding_usd": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Funding Usd"
          },
          "authority_declared": {
            "type": "boolean",
            "title": "Authority Declared",
            "default": false
          },
          "attestation_accepted": {
            "type": "boolean",
            "title": "Attestation Accepted",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "company_name",
          "domain",
          "applicant_name",
          "work_email",
          "applicant_role",
          "product_description"
        ],
        "title": "ApplicationInput"
      },
      "FactCorrections": {
        "properties": {
          "founding_year": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2100.0,
                "minimum": 1800.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Founding Year"
          },
          "headcount": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Headcount"
          },
          "funding_usd": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Funding Usd"
          },
          "product_kind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "software",
                  "other",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Kind"
          },
          "authority_declared": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authority Declared"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "FactCorrections"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ResolutionInput": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "request_information",
              "waive_conflict",
              "decline"
            ],
            "title": "Action"
          },
          "reason": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 15,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "reason"
        ],
        "title": "ResolutionInput"
      },
      "ResponseInput": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000,
            "title": "Text",
            "default": ""
          },
          "facts": {
            "$ref": "#/components/schemas/FactCorrections"
          },
          "source_urls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Source Urls"
          },
          "attestation_accepted": {
            "type": "boolean",
            "title": "Attestation Accepted",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ResponseInput"
      },
      "UsageInput": {
        "properties": {
          "amount_cents": {
            "type": "integer",
            "maximum": 50000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount Cents"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Description"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "amount_cents",
          "description"
        ],
        "title": "UsageInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerificationInput": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 6,
            "minLength": 6,
            "pattern": "^\\d{6}$",
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "VerificationInput"
      }
    }
  }
}